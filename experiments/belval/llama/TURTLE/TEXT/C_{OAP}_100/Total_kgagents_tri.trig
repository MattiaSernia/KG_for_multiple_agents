}

<http://example.org/extraction/pro/extraction10> {
    pro:pro1 a ex:Proposal ;
        ns1:proposes <http://example.org/node/an_artificial_intelligence_solution_to_assist_municipal_agents_of_the_city_of_belval_in_their_daily_missions> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro10 a ex:Proposal ;
        ns1:will_leverage <http://example.org/node/green_hosting_partners_ovhcloud_and_scaleway_which_use_100_renewable_energy_to_reduce_energetic_consumption_and_rely_on_low_carbon_impact_infrastructures> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro11 a ex:Proposal ;
        ns1:will_implement <http://example.org/node/digital_sobriety_practices_including_int8_int4_model_quantisation_auto_scaling_to_zero_outside_business_hours_query_result_caching_and_a_green_it_hardware_procurement_policy> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro12 a ex:Proposal ;
        ns1:are_committed_to_reducing <http://example.org/node/nexus_engineering_s_r_l_total_scope_1_and_2_emissions_which_were_148_tco2e_in_the_last_reported_year_and_have_set_a_net_zero_target_for_2040> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro2 a ex:Proposal ;
