<http://example.org/extraction/pro/extraction75> {
    pro:pro1 a ex:Proposal ;
        ns1:proposes <http://example.org/node/a_comprehensive_solution_to_address_the_city_of_belval_s_digital_transformation_strategy> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro2 a ex:Proposal ;
        ns1:will_deliver <http://example.org/node/a_tailored_solution> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro3 a ex:Proposal ;
        ns1:will_facilitate <http://example.org/node/access_to_information> ;
        rdf:subject <http://example.org/node/the_proposed_intelligent_assistance_tool> .

    pro:pro4 a ex:Proposal ;
        ns1:will_improve <http://example.org/node/the_quality_of_answers> ;
        rdf:subject <http://example.org/node/the_proposed_intelligent_assistance_tool> .

    pro:pro5 a ex:Proposal ;
        ns1:will_reduce <http://example.org/node/processing_times_for_municipal_agents> ;
        rdf:subject <http://example.org/node/the_proposed_intelligent_assistance_tool> .
}

<http://example.org/extraction/req/extraction6> {
    req:req28 a ex:Requirement ;
        ns1:achieve <http://example.org/node/response_time_lower_than_2_seconds> ;
        ex:category ex:service_performance ;
        ex:priority ex:should ;
        rdf:subject <http://example.org/node/users> .

    req:req29 a ex:Requirement ;
        ns1:obtain <http://example.org/node/high_level_of_relevance_of_answers> ;
        ex:category ex:information_quality ;
        ex:priority ex:should ;
        rdf:subject <http://example.org/node/users> .

    req:req30 a ex:Requirement ;
        ns1:have <http://example.org/node/high_level_of_availability> ;
        ex:category ex:municipal_services ;
        ex:priority ex:should ;
        rdf:subject <http://example.org/node/municipal_services> .

    req:req31 a ex:Requirement ;
        ns1:integrate <http://example.org/node/existing_system_of_information> ;
        ex:category ex:system_integration ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/req/extraction3> {
    req:req13 a ex:Requirement ;
        ns1:access <http://example.org/node/reliable_and_up_to_date_information> ;
        ex:category ex:information_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/agents> .

    req:req14 a ex:Requirement ;
        ns1:contextualize <http://example.org/node/answers_in_function_of_the_demand_of_the_agent> ;
        ex:category ex:information_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .

    req:req15 a ex:Requirement ;
        ns1:propose <http://example.org/node/help_with_the_drafting_of_administrative_contents> ;
        ex:category ex:document_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .

    req:req16 a ex:Requirement ;
        ns1:adapt <http://example.org/node/to_the_administrative_context> ;
        ex:category ex:document_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/generated_contents> .

    req:req17 a ex:Requirement ;
        ns1:analyze <http://example.org/node/files_with_relevant_information_and_applicable_rules> ;
        ex:category ex:file_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/agents> .

    req:req18 a ex:Requirement ;
        ns1:suggest <http://example.org/node/actions_or_verifications_to_carry_out> ;
        ex:category ex:file_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/con/extraction16> {
    con:con15 a ex:Constraint ;
        ns1:is_expected_to_be_lower_than <http://example.org/node/2_seconds> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/time_of_response> .

    con:con16 a ex:Constraint ;
        ns1:will_have_to_guarantee <http://example.org/node/a_high_level_of_availability_compatible_with_the_needs_of_the_municipal_services> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/availability_of_the_solution> .

    con:con17 a ex:Constraint ;
        ns1:is_expected_to_be_of_the_order_of <http://example.org/node/99_9> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/availability_of_the_solution> .

    con:con18 a ex:Constraint ;
        ns1:will_have_to_integrate_with <http://example.org/node/existing_system_of_information_including_business_softwares_and_electronic_management_of_documents> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution> .
}

