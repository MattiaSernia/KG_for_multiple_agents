<http://example.org/extraction/tri/extraction26> {
    tri:tri28 a ex:Triplet ;
        ns1:has_project_management_capacity <http://example.org/node/available> ;
        rdf:subject <http://example.org/node/nexus_engineering> .

    tri:tri29 a ex:Triplet ;
        ns1:has_regulatory_requirements <http://example.org/node/up_to_date> ;
        rdf:subject <http://example.org/node/city_of_belval> .

    tri:tri30 a ex:Triplet ;
