<http://example.org/extraction/con/extraction7> {
    con:con13 a ex:Constraint ;
        ns1:will_have_to_be_realized_on <http://example.org/node/infrastructure_of_secnumcloud_type_or_equivalent> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/hosting> .

    con:con14 a ex:Constraint ;
        ns1:will_be_brought_to_a_particular_attention <http://example.org/node/vis_vis_non_european_suppliers> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/dependence> .

    con:con15 a ex:Constraint ;
        ns1:is_estimated_at <http://example.org/node/3_million_euros_over_a_duration_of_4_years> ;
        ex:constraintType ex:budgetary ;
        rdf:subject <http://example.org/node/global_budget> .

    con:con16 a ex:Constraint ;
        ns1:will_have_to_remain <http://example.org/node/mastered_and_compatible_with_the_budgetary_capacities_of_the_local_authority> ;
        ex:constraintType ex:budgetary ;
        rdf:subject <http://example.org/node/annual_cost_of_exploitation> .

    con:con17 a ex:Constraint ;
        ns1:will_have_to_be_limited <http://example.org/node/by_reducing_energetic_consumption> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/environmental_footprint_of_city_of_belval_systems_of_information> .

    con:con18 a ex:Constraint ;
        ns1:will_have_to_rely <http://example.org/node/as_much_as_possible_on_infrastructures_with_low_carbon_impact> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/solution> .

    con:con19 a ex:Constraint ;
        ns1:will_have_to_be_conducted <http://example.org/node/in_a_progressive_manner_with_a_pilot_phase_and_progressive_generalization> ;
        ex:constraintType ex:temporal ;
        rdf:subject <http://example.org/node/project_deployment> .
}

