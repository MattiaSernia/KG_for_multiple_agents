    <http://example.org/node/chunk144> a prov:Entity ;
        ex:hasText "By building on our company's existing sustainability initiatives and incorporating environmentally responsible design principles into our solution, our company's can ensure that our solution not only meets but exceeds the client's environmental expectations." ;
