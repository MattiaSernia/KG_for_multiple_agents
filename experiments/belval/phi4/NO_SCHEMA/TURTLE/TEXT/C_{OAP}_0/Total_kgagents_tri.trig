        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk141> a prov:Entity ;
        ex:hasText "By implementing low-power standby modes with less than 90 seconds wake-up time, our company's can minimize energy waste while maintaining the required level of availability." ;
