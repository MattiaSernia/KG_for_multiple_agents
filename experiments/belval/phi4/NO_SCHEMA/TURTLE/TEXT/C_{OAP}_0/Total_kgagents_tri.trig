    <http://example.org/node/chunk109> a prov:Entity ;
        ex:hasText "The client has a global budget allocated to the project of 3 million euros over a duration of 4 years, with an annual cost of exploitation that must remain mastered and compatible with the budgetary capacities of the local authority." ;
