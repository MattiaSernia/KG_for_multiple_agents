    <http://example.org/node/chunk57> a prov:Entity ;
        ex:hasText "An accompaniment to the change and actions of training of the agents will be expected. 10." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk58> a prov:Entity ;
        ex:hasText "Criteria of evaluation of the offers the offers will be evaluated with regard to the following criteria: quality and relevance of the proposed solution, compliance to the regulatory requirements, level of security, global cost of the proposed solution, taking into account of the environmental issues, capacity of innovation." ;
