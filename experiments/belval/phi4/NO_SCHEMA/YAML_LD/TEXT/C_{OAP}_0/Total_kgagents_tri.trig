<http://example.org/extraction/tri/extraction75> {
    tri:tri38 a ex:Triplet ;
        ns1:is_covered_by <http://example.org/node/designed_security_practices> ;
        rdf:subject <http://example.org/node/the_requirement> .

    tri:tri39 a ex:Triplet ;
        ns1:is <http://example.org/node/fully_covered> ;
        rdf:subject <http://example.org/node/the_coverage_level> .
}

<http://example.org/extraction/tri/extraction132> {
    tri:tri173 a ex:Triplet ;
        ns1:hasexperiencewith <http://example.org/node/api_standards> ;
        rdf:subject <http://example.org/node/mycompany> .

    tri:tri174 a ex:Triplet ;
        ns1:integrateswith <http://example.org/node/ged_systems> ;
        rdf:subject <http://example.org/node/mycompany> .

    tri:tri175 a ex:Triplet ;
        ns1:integrateswith <http://example.org/node/identity_providers> ;
        rdf:subject <http://example.org/node/mycompany> .
}

<http://example.org/extraction/tri/extraction202> {
    tri:tri300 a ex:Triplet ;
        ns1:includes <http://example.org/node/renegotiate_rates_with_subcontractors_if_possible_as_indicated_by_our_cost_sensitivity_analysis_for_budget_reductions> ;
        rdf:subject <http://example.org/node/cost_optimization_strategies> .

    tri:tri301 a ex:Triplet ;
        ns1:includes <http://example.org/node/scope_reduction_or_removal_of_optional_modules_to_minimize_costs_while_still_meeting_essential_requirements> ;
        rdf:subject <http://example.org/node/cost_optimification_strategies> .

    tri:tri302 a ex:Triplet ;
        ns1:includes <http://example.org/node/implementation_of_efficient_project_management_practices_to_reduce_waste_and_enhance_productivity> ;
        rdf:subject <http://example.org/node/cost_optimization_strategies> .

    tri:tri303 a ex:Triplet ;
        ns1:result_in <http://example.org/node/reducing_costs_without_compromising_the_quality_of_service_expected_by_the_client_thus_potentially_enhancing_our_projected_margin_on_this_contract> ;
        rdf:subject <http://example.org/node/efficient_project_management_practices> .
}

