@prefix con: <http://example.org/constraint/> .
@prefix ex: <http://example.org/ontologia#> .
@prefix ns1: <http://example.org/edge/> .
@prefix pro: <http://example.org/proposal/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix req: <http://example.org/requirement/> .
@prefix tri: <http://example.org/triplet/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extraction/req/extraction27> {
    req:req60 a ex:Requirement ;
        ns1:must_have <http://example.org/node/modalities_of_deployment_that_must_be_conducted_in_a_progressive_manner_with_a_pilot_phase_on_a_limited_scope_a_progressive_generalization_to_the_entirety_of_the_services> ;
        rdf:subject <http://example.org/node/project> .
}

<http://example.org/extraction/tri/extraction76> {
    tri:tri48 a ex:Triplet ;
        ns1:must_have <http://example.org/node/response_times_under_2_seconds> ;
        rdf:subject <http://example.org/node/the_solution> .

    tri:tri49 a ex:Triplet ;
        ns1:must_achieve <http://example.org/node/high_availability_99_9> ;
        rdf:subject <http://example.org/node/the_solution> .

    tri:tri50 a ex:Triplet ;
        ns1:must_ensure <http://example.org/node/explicability_and_transparency> ;
        rdf:subject <http://example.org/node/the_solution> .
}

<http://example.org/extraction/pro/extraction139> {
    pro:pro4 a ex:Proposal ;
        ns1:has_completed <http://example.org/node/23_public_sector_projects> ;
        rdf:subject <http://example.org/node/our_consortium> .

    pro:pro5 a ex:Proposal ;
        ns1:will_be_accessible_from <http://example.org/node/agents_work_environment> ;
        rdf:subject <http://example.org/node/an_artificial_intelligence_solution> .

    pro:pro6 a ex:Proposal ;
        ns1:will_assist_in <http://example.org/node/administrative_activities> ;
        rdf:subject <http://example.org/node/an_artificial_intelligence_solution> .

    pro:pro7 a ex:Proposal ;
        ns1:was_valued_at <http://example.org/node/4_5_million_euros> ;
        rdf:subject <http://example.org/node/the_largest_project_completed_by_our_consortium> .

    pro:pro8 a ex:Proposal ;
        ns1:will_enable_the_search_for_information <http://example.org/node/in_internal_procedures_and_applicable_regulations> ;
        rdf:subject <http://example.org/node/an_artificial_intelligence_solution> .

    pro:pro9 a ex:Proposal ;
        ns1:will_assist_with <http://example.org/node/drafting_letters_or_answers_to_users> ;
        rdf:subject <http://example.org/node/an_artificial_intelligence_solution> .
}

<http://example.org/extraction/con/extraction41> {
    con:con26 a ex:Constraint ;
        ns1:must_be_located_in <http://example.org/node/european_union> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/data> .

    con:con27 a ex:Constraint ;
        ns1:must_guarantee <http://example.org/node/explicability_and_transparency> ;
        rdf:subject <http://example.org/node/solution> .

    con:con28 a ex:Constraint ;
        ns1:must_not_transfer <http://example.org/node/european_union> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/data> .
}

<http://example.org/extraction/tri/extraction106> {
    tri:tri157 a ex:Triplet ;
        ns1:hasexperiencewithpublicprocurementin <http://example.org/node/france_germany_belgium_and_eu_institutions> ;
        rdf:subject <http://example.org/node/company> .

    tri:tri158 a ex:Triplet ;
        ns1:shouldreview <http://example.org/node/standardcontractualclauses> ;
        rdf:subject <http://example.org/node/company> .

    tri:tri159 a ex:Triplet ;
        ns1:includes <http://example.org/node/price_revision_mechanism_termination_notice_periods_data_return_and_destruction_obligations_upon_contract_termination> ;
        rdf:subject <http://example.org/node/standardcontractualclauses> .

    tri:tri160 a ex:Triplet ;
        ns1:ensurescompliancewithclientrequirements <http://example.org/node/standardcontractualclauses> ;
        rdf:subject <http://example.org/node/company> .
}

<http://example.org/extraction/tri/extraction69> {
    tri:tri30 a ex:Triplet ;
        ns1:manages <http://example.org/node/the_project> ;
        rdf:subject <http://example.org/node/the_city_of_belval> .
}

<http://example.org/extraction/con/extraction45> {
    con:con33 a ex:Constraint ;
        ns1:is_limited_to <http://example.org/node/less_than_2_0_seconds> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/response_time> .
}

<http://example.org/extraction/req/extraction19> {
    req:req45 a ex:Requirement ;
        ns1:type <http://example.org/node/interface> ;
        ex:category ex:service_management ;
        rdf:subject <http://example.org/node/api> .
}

<http://example.org/extraction/req/extraction17> {
    req:req40 a ex:Requirement ;
        ns1:must_improve <http://example.org/node/availability> ;
        ex:category ex:service_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/municipality> .

    req:req41 a ex:Requirement ;
        ns1:must_guarantee <http://example.org/node/high_level_of_availability_compatible_with_the_needs_of_the_municipal_services> ;
        ex:category ex:service_management ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/solution> .

    req:req42 a ex:Requirement ;
        ns1:must_have <http://example.org/node/high_level_of_relevance> ;
        ex:category ex:information_access ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/answers> .
}

