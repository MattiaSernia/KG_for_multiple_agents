    <http://example.org/node/chunk140> a prov:Entity ;
        ex:hasText "To ensure compliance with regulatory requirements, an artificial intelligence solution to assist its agents in their daily missions will be designed as a tool of assistance, with no decision automated without explicit validation by an agent." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk141> a prov:Entity ;
        ex:hasText "Our consortium guarantee strict compliance with the General Data Protection Regulation (GDPR) and will host all data exclusively on SecNumCloud infrastructure or equivalent, ensuring that no transfer of data outside the European Union will occur." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk142> a prov:Entity ;
        ex:hasText "Our consortium technical architecture is based on Our consortium primary domains of expertise: AI/ML systems, cloud architecture, API integration, data engineering, and cybersecurity." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk143> a prov:Entity ;
        ex:hasText "Our consortium will utilize API-type interfaces to integrate with existing systems, such as business software, civil status, town planning, electronic management of documents (EDM), and user directories. an artificial intelligence solution to assist its agents in their daily missions will provide response times under 2 seconds for current requests and achieve high availability of 99.9%." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk144> a prov:Entity ;
        ex:hasText "Our consortium prioritize explicability and transparency in an artificial intelligence solution to assist its agents in their daily missions, ensuring that the recommendations or proposals issued can be explained a posteriori." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk145> a prov:Entity ;
        ex:hasText "Our consortium implement explainability tools such as SHAP, LIME, chain-of-thought prompting, and RAG source citation to provide insights into the decision-making process." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk146> a prov:Entity ;
        ex:hasText "Our consortium approach aligns with The City of Belval digital transformation strategy and commitment to sustainability." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk147> a prov:Entity ;
        ex:hasText "Our consortium propose implementing digital sobriety practices, such as model quantization (INT8/INT4), auto-scaling to zero outside business hours, query result caching, and a green IT hardware procurement policy with a minimum 5-year lifecycle." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk148> a prov:Entity ;
        ex:hasText "Our consortium partnership with green hosting providers like OVHcloud and Scaleway, which use 100% renewable energy, contributes to reducing the environmental footprint of The City of Belval information systems." ;
