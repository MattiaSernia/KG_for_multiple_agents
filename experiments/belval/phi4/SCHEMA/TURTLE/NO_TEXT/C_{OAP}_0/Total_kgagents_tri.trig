    <http://example.org/node/chunk93> a prov:Entity ;
        ex:hasText "As of 2024, our annual revenue is 4,200,000 euros, and our net profit is 380,000 euros. our current cash position is 520,000 euros, and our have a credit line available of 300,000 euros. our overhead monthly costs are 145,000 euros." ;
        prov:wasDerivedFrom <http://example.org/node/message11> .

    <http://example.org/node/chunk94> a prov:Entity ;
