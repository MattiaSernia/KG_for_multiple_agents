    <http://example.org/node/chunk98> a prov:Entity ;
        ex:hasText "In terms of security, we has a limitation of liability standard of 3 million euros, professional indemnity insurance of 5 million euros, and cyber liability insurance of 2 million euros, provided by AXA XL. we also have a performance bond capacity of 1.5 million euros." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk99> a prov:Entity ;
