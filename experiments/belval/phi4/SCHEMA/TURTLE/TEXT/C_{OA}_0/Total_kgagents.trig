        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk132> a prov:Entity ;
        ex:hasText "Data Protection Officer (DPO) is appointed, and Our Data Protection Officer (DPO) contact information is available at dpo@nexus-engineering.it." ;
