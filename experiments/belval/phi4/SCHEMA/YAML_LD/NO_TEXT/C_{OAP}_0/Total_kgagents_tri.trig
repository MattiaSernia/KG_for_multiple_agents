@prefix con: <http://example.org/constraint/> .
@prefix ex: <http://example.org/ontologia#> .
@prefix ns1: <http://example.org/edge/> .
@prefix pro: <http://example.org/proposal/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix req: <http://example.org/requirement/> .
@prefix tri: <http://example.org/triplet/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extraction/req/extraction12> {
    req:req35 a ex:Requirement ;
        ns1:must_assist <http://example.org/node/explainability_and_transparency> ;
        ex:category ex:explainability ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/the_expected_solution> .

    req:req36 a ex:Requirement ;
        ns1:must_be_hosted <http://example.org/node/exclusively_on_the_territory_of_the_european_union> ;
        ex:category ex:data_hosting ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/data> .

    req:req37 a ex:Requirement ;
        ns1:must_not_have <http://example.org/node/transfer_outside_the_european_union> ;
        ex:category ex:data_transfer ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/data> .

    req:req38 a ex:Requirement ;
        ns1:must_be_protected <http://example.org/node/in_an_appropriate_manner_encryption_anonymization_if_necessary> ;
        ex:category ex:data_protection ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/data> .
}

<http://example.org/extraction/tri/extraction85> {
    tri:tri102 a ex:Triplet ;
        ns1:data_residency_policy <http://example.org/node/european_union> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    tri:tri103 a ex:Triplet ;
        ns1:cross_border_transfer_policy <http://example.org/node/prohibits_transfers_outside_the_european_union_unless_there_s_an_explicit_legal_basis> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .
}

<http://example.org/extraction/con/extraction54> {
    con:con48 a ex:Constraint ;
        ns1:must_comply_with <http://example.org/node/policy_of_sustainable_development> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/city_of_belval> .

    con:con49 a ex:Constraint ;
        ns1:wishes_to_limit <http://example.org/node/environmental_footprint_of_city_of_belval_systems_of_information> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/city_of_belval> .
}

<http://example.org/extraction/req/extraction8> {
    req:req23 a ex:Requirement ;
        ns1:assist_with_the_drafting_of <http://example.org/node/administrative_contents_notably_answers_to_the_users_administrative_letters_syntheses_of_files> ;
        ex:category ex:drafting ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/expected_solution> .

    req:req24 a ex:Requirement ;
        ns1:contextualize_the_answers_in_function_of <http://example.org/node/the_demand_of_the_agent> ;
        ex:category ex:information_extraction ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/expected_solution> .
}

<http://example.org/extraction/pro/extraction141> {
    pro:pro30 a ex:Proposal ;
        ns1:will_deliver <http://example.org/node/training_for_agents> ;
        rdf:subject <http://example.org/node/nexus_engineering_s_r_l> .

    pro:pro31 a ex:Proposal ;
        ns1:provides <http://example.org/node/artificial_intelligence_assistance_to_agents_in_their_daily_missions> ;
        rdf:subject <http://example.org/node/the_solution> .

    pro:pro32 a ex:Proposal ;
        ns1:improves <http://example.org/node/efficiency_of_administrative_services> ;
        rdf:subject <http://example.org/node/the_solution> .

    pro:pro33 a ex:Proposal ;
        ns1:ensures <http://example.org/node/quality_of_service_rendered_to_users> ;
        rdf:subject <http://example.org/node/the_solution> .

    pro:pro34 a ex:Proposal ;
        ns1:complies_with <http://example.org/node/regulatory_requirements> ;
        rdf:subject <http://example.org/node/the_solution> .

    pro:pro35 a ex:Proposal ;
        ns1:adheres_to <http://example.org/node/principles_of_sovereignty_of_data> ;
        rdf:subject <http://example.org/node/the_solution> .

    pro:pro36 a ex:Proposal ;
        ns1:ensures <http://example.org/node/gdpr_compliance> ;
        rdf:subject <http://example.org/node/the_solution> .
}

<http://example.org/extraction/req/extraction28> {
    req:req64 a ex:Requirement ;
        ns1:must_support <http://example.org/node/training_of_agents> ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/organization> .
}

