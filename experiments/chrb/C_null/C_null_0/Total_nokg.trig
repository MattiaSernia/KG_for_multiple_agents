    <http://example.org/node/chunk98> a prov:Entity ;
        ex:hasText "The Centre Hospitalier Régional de Belval (CHRB) will start by applying The Centre Hospitalier Régional de Belval (CHRB) Framing phase to define the project scope, objectives, and deliverables, followed by the Design phase where The Centre Hospitalier Régional de Belval (CHRB) will tailor The Centre Hospitalier Régional de Belval (CHRB) flagship product Atelier to meet The Centre Hospitalier Régional de Belval (CHRB) specific needs." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk99> a prov:Entity ;
