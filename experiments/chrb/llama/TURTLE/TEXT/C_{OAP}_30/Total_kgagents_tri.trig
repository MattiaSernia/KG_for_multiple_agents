<http://example.org/extraction/pro/extraction30> {
    pro:pro1 a ex:Proposal ;
        ns1:proposes <http://example.org/node/an_artificial_intelligence_solution_designed_to_assist_hospital_staff_in_hospital_staff_daily_activities> ;
        rdf:subject <http://example.org/node/faber_ia> .

    pro:pro10 a ex:Proposal ;
        ns1:ensures <http://example.org/node/sensitive_data_is_appropriately_protected_by_encryption_and_pseudonymisation_where_relevant> ;
        rdf:subject <http://example.org/node/faber_ia> .

    pro:pro11 a ex:Proposal ;
        ns1:is_hosted_on <http://example.org/node/ouranecloud_a_french_sovereign_cloud_provider_that_is_secnumcloud_qualified_and_hds_certified> ;
        rdf:subject <http://example.org/node/faber_ia_infrastructure> .

