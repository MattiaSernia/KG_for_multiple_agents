<http://example.org/extraction/req/extraction1> {
    req:req1 a ex:Requirement ;
        ns1:improve <http://example.org/node/efficiency> ;
        ex:category ex:healthcare ;
        rdf:subject <http://example.org/node/hospital_staff> .

    req:req10 a ex:Requirement ;
        ns1:ensure <http://example.org/node/continuity_of_care_between_professionals_shifts_and_services> ;
        ex:category ex:healthcare ;
        rdf:subject <http://example.org/node/professionals> .

    req:req2 a ex:Requirement ;
        ns1:enhance <http://example.org/node/quality_and_safety_of_care_delivered_to_patients> ;
        ex:category ex:healthcare ;
        rdf:subject <http://example.org/node/hospital_staff> .

    req:req3 a ex:Requirement ;
        ns1:facilitate <http://example.org/node/access_to_information> ;
        ex:category ex:healthcare ;
