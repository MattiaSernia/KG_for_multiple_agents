    <http://example.org/node/chunk1> a prov:Entity ;
        ex:hasText "Public Tender - Centre Hospitalier Régional de Belval (CHRB) Implementation of an AI assistance solution for hospital staff 1." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk10> a prov:Entity ;
        ex:hasText "The solution must let staff quickly access reliable, up-to-date information drawn from the authority's internal procedures, care protocols and HAS recommendations, applicable regulatory texts, and internal documents (guides, notes, reference frameworks, drug references)." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk100> a prov:Entity ;
        ex:hasText "The phases are Framing, Design, Pilot, Generalisation, and Run." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "In Framing, our will define the project scope, goals, and deliverables, and establish the joint steering committee and operational committee." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk102> a prov:Entity ;
        ex:hasText "Framing is expected to last about 2 months with a dedicated project director and solution architect." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk103> a prov:Entity ;
        ex:hasText "The Design phase will involve designing The solution, including the integration with existing systems and workflows. our data scientist and engineers will work closely with the client to ensure The solution meets the client requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "The Design phase is expected to last around 3 months." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk105> a prov:Entity ;
        ex:hasText "In Pilot, our will develop a prototype of The solution and test a prototype of the AI assistance solution with a small group of hospital staff. our partners, Ligeo Santé, will assist with SIH/DPI integration and FHIR/INS interoperability work." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "Pilot is expected to last about 4 months." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk107> a prov:Entity ;
        ex:hasText "Generalisation will involve scaling up The solution to the entire hospital staff, providing training and support, and ensuring a smooth transition to the new system. our change-management and training resources will be allocated to Generalisation." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "Generalisation is expected to last around 5 months." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk109> a prov:Entity ;
        ex:hasText "Finally, in Run, our will ensure The solution is fully operational, provide ongoing maintenance and support, and monitor The solution performance. our security compliance lead will ensure The solution meets all security and compliance requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk11> a prov:Entity ;
        ex:hasText "The solution must contextualise The solution answers to the staff member's request. 3.2 Drafting assistance." ;
