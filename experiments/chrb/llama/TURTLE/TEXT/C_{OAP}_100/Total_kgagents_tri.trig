    con:con10 a ex:Constraint ;
        ns1:must_support <http://example.org/node/health_interoperability_standards_hl7_fhir_national_health_identifier_ins_and_national_framework_s_gur_du_num_rique_en_sant_mon_espace_sant_dmp> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution> .

    con:con11 a ex:Constraint ;
        ns1:must_be_performed_on <http://example.org/node/secnumcloud_qualified_infrastructure_or_equivalent> ;
