        rdf:subject <http://example.org/node/solution> .

    con:con15 a ex:Constraint ;
        ns1:must_rely_on <http://example.org/node/low_carbon_infrastructure> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/solution> .

    con:con2 a ex:Constraint ;
        ns1:must_be_hosted_exclusively_within <http://example.org/node/european_union> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/health_data> .

    con:con3 a ex:Constraint ;
        ns1:must_not_be_transferred_outside <http://example.org/node/european_union> ;
