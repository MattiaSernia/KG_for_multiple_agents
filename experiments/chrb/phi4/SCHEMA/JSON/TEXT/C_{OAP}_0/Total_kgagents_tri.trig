    <http://example.org/node/chunk154> a prov:Entity ;
        ex:hasText "That being said, if our operate within our target gross margin range of 25% to 35%, our revenue from this project would be between €1,125,000 (25% margin) and €1,285,714 (35% margin), based on total costs of €900,000." ;
        prov:wasDerivedFrom <http://example.org/node/message11> .

    <http://example.org/node/chunk155> a prov:Entity ;
        ex:hasText "However, these calculations are rough estimates and do not account for various factors that might influence the actual project costs." ;
