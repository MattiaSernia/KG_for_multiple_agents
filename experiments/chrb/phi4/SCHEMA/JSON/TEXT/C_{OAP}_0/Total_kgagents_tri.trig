    <http://example.org/node/chunk152> a prov:Entity ;
        ex:hasText "Assuming our costs are within these proportions, our can estimate a target gross margin between 25% and 35%t." ;
        prov:wasDerivedFrom <http://example.org/node/message11> .

    <http://example.org/node/chunk153> a prov:Entity ;
        ex:hasText "However, without specific details on the roles and resources required for this project, it's challenging to provide an exact calculation of a target gross margin between 25% and 35%." ;
