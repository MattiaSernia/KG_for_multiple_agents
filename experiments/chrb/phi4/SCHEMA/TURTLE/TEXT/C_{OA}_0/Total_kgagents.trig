    <http://example.org/node/chunk191> a prov:Entity ;
        ex:hasText "The Centre Hospitalier Régional de Belval (CHRB) is seeking an artificial intelligence solution to assist hospital staff in hospital staff daily activities, improving efficiency and quality of care while ensuring strict compliance with regulatory requirements." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk192> a prov:Entity ;
        ex:hasText "Our consortium proposes a comprehensive solution that addresses these needs, leveraging The Centre Hospitalier Régional de Belval (CHRB) expertise in AI, healthcare, and sustainability." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk193> a prov:Entity ;
        ex:hasText "Our consortium approach begins with a Hybrid delivery model, combining agile iterations with a phase-gate structure suited to public and health procurement. a Hybrid delivery model, combining agile iterations with a phase-gate structure suited to public and health procurement has been successfully applied in past references, such as regional council and mutual health insurer projects." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk194> a prov:Entity ;
        ex:hasText "Our consortium propose the following key milestones and deliverables: Framing Phase, Design Phase, Pilot Phase, Generalisation Phase, and Run Phase." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk195> a prov:Entity ;
        ex:hasText "Each phase will include specific deliverables, including a detailed project plan, functional specification document, user interface prototypes, data integration plan, training for hospital staff, and change management support." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk196> a prov:Entity ;
        ex:hasText "Our consortium proposed solution, Atelier, is designed to provide fast response times, with a median latency of 1.3 seconds and a p95 latency of less than 2 seconds for common single-document queries." ;
