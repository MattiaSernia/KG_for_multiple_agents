    <http://example.org/node/chunk197> a prov:Entity ;
        ex:hasText "Our consortium offer 24/7 operation on the appropriate hosting tier, with an active-active setup across two availability zones to ensure high availability." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

