    <http://example.org/node/chunk202> a prov:Entity ;
        ex:hasText "Our consortium hosting partner, OuraneCloud, holds the French Hébergeur de Données de Santé (HDS) certification, ensuring that Our hosting partner, OuraneCloud infrastructure meets the necessary standards for hosting health data in France." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk203> a prov:Entity ;
        ex:hasText "Our hosting partner, OuraneCloud also provide encryption in transit using TLS 1.3 and encryption at rest using AES-256, as well as key management on the EU infrastructure, pseudonymisation capabilities, and configurable retention policies to protect sensitive health data. our solution is designed as an assistance tool, with no clinical or medico-administrative decision automated without explicit validation by a qualified professional." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk204> a prov:Entity ;
        ex:hasText "Our hosting partner, OuraneCloud ensure that our solution does not require medical-device qualification (CE marking / MDR) and flag any use case that could approach the medical-device threshold, addressing the implications for liability and positioning." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk205> a prov:Entity ;
        ex:hasText "In terms of budget, Our hosting partner, OuraneCloud aim to work within a target gross margin percentage range of 25% to 35%." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk206> a prov:Entity ;
        ex:hasText "Considering the client's global budget of €900,000 over 5 years, Our hosting partner, OuraneCloud pricing model, and the need to control annual operating costs, Our hosting partner, OuraneCloud will propose cost-optimisation strategies." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk207> a prov:Entity ;
        ex:hasText "Our hosting partner, OuraneCloud favour configurations that protect the gross margin and recurring-cost predictability, and arbitrates toward more cost-efficient tiers/models where the requirements allow. our solution leverages Retrieval-augmented generation (RAG) capabilities, incorporating hybrid retrieval, multi-document synthesis, and template-guided drafting features to improve the quality of written outputs and reduce processing and documentation times." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk208> a prov:Entity ;
        ex:hasText "Our hosting partner, OuraneCloud adopt an iterative approach, involving corpus selection and curation with the client's experts, retrieval tuning, prompt and template design per use case, and evaluation loop." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

    <http://example.org/node/chunk209> a prov:Entity ;
        ex:hasText "Our hosting partner, OuraneCloud model selection principle trades performance against explainability and sovereignty, ensuring that the chosen AI model aligns with the client's requirements and regulatory constraints." ;
        prov:wasDerivedFrom <http://example.org/node/message17> .

