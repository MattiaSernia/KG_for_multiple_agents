    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "Integration with the existing hospital information system (SIH) and electronic patient record (DPI): our architecture_and_integration_capabilities include standard connectors and custom adapters for SIH/DPI integration, which FULLY COVERS this requirement. 5." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk109> a prov:Entity ;
