    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "High availability including outside office hours (24/7 services): our have a 99.9% availability target and operate 24/7, which FULLY COVERS this requirement. 3." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk107> a prov:Entity ;
