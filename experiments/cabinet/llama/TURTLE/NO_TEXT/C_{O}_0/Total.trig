    <http://example.org/node/chunk100> a prov:Entity ;
        ex:hasText "Additionally, our would implement user directory SSO and ensure access control measures are in place to preserve professional secrecy and maintain confidentiality." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "The tender requires strict confidentiality (req2), professional secrecy (req6) and reliability of figures (req7), with personal data complying with GDPR (con24), client and employee personal and financial data processed in compliance with GDPR (con25), sensitive data protected with encryption pseudonymisation (con28), a complete audit trail (con31), explainability (con32), non-decisional assistance tool (con34), respecting auditor's independence (con35) and separation of duties (con36)." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk102> a prov:Entity ;
