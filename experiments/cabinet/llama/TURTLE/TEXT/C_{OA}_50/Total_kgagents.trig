<http://example.org/extraction/con/extraction4> {
    con:con10 a ex:Constraint ;
        ns1:must_not_be <http://example.org/node/ungrounded> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/numeric_output> .

    con:con11 a ex:Constraint ;
        ns1:is_required_to_have <http://example.org/node/completeness> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/audit_trail> .

    con:con12 a ex:Constraint ;
        ns1:is_required_to_have <http://example.org/node/completeness> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/explainability> .

    con:con13 a ex:Constraint ;
        ns1:must_respect <http://example.org/node/auditor_s_independence_and_separation_of_duties> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/solution> .

    con:con14 a ex:Constraint ;
        ns1:must_not_undermine <http://example.org/node/cabinet_vauclair_associ_s_anti_money_laundering_obligations_lcb_ft> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/solution> .

    con:con15 a ex:Constraint ;
        ns1:must_comply_with <http://example.org/node/legal_retention_and_archival_obligations_for_accounting_documents> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/titleholder> .

    con:con16 a ex:Constraint ;
        ns1:are_expected_to_be <http://example.org/node/below_2_seconds_for_common_queries> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/response_times> .

    con:con17 a ex:Constraint ;
        ns1:must_sustain <http://example.org/node/during_seasonal_peak_loads> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution_performance> .

    con:con18 a ex:Constraint ;
        ns1:is_required_to_have <http://example.org/node/high_level_during_business_hours> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/availability> .

    con:con19 a ex:Constraint ;
        ns1:must_integrate_with <http://example.org/node/cabinet_vauclair_associ_s_production_tools> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution> .

    con:con20 a ex:Constraint ;
        ns1:must_integrate_with <http://example.org/node/electronic_invoicing_dematerialisation_environment> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution> .

    con:con21 a ex:Constraint ;
        ns1:are_expected_to_be <http://example.org/node/api_type> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/interfaces> .

    con:con22 a ex:Constraint ;
        ns1:must_integrate_with <http://example.org/node/user_directory_sso> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/solution> .

    con:con23 a ex:Constraint ;
        ns1:is_preferred_to_be <http://example.org/node/secnumcloud_qualified_or_equivalent> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/hosting_infrastructure> .

    con:con24 a ex:Constraint ;
        ns1:is <http://example.org/node/220_000_over_3_years> ;
        ex:constraintType ex:budgetary ;
        rdf:subject <http://example.org/node/budget_allocated_to_the_project> .

    con:con25 a ex:Constraint ;
        ns1:must_remain <http://example.org/node/controlled> ;
        ex:constraintType ex:budgetary ;
        rdf:subject <http://example.org/node/annual_operating_cost> .

    con:con26 a ex:Constraint ;
        ns1:is_preferred_to_be <http://example.org/node/low_carbon> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/infrastructure> .

    con:con27 a ex:Constraint ;
        ns1:must_be_conducted <http://example.org/node/progressively_with_a_pilot_phase> ;
        ex:constraintType ex:temporal ;
        rdf:subject <http://example.org/node/project_deployment> .

    con:con9 a ex:Constraint ;
        ns1:must_be_grounded_in_and_traceable_to <http://example.org/node/a_source_document> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/figure_or_factual_statement_produced_by_the_solution> .
}

