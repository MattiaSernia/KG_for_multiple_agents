    pro:pro10 a ex:Proposal ;
        ns1:provides <http://example.org/node/a_complete_audit_trail_through_logging_of_access_and_every_system_output_as_well_as_configurable_retention_aligned_to_legal_archival_obligations> ;
        rdf:subject <http://example.org/node/ouranecloud_s> .

    pro:pro11 a ex:Proposal ;
        ns1:budgets <http://example.org/node/220_000_for_the_project_over_3_years> ;
        rdf:subject <http://example.org/node/faber_ia> .

    pro:pro2 a ex:Proposal ;
        ns1:will_provide <http://example.org/node/intelligent_assistance_to_cabinet_vauclair_associ_s_professionals> ;
        rdf:subject <http://example.org/node/faber_ia> .

    pro:pro3 a ex:Proposal ;
        ns1:leverages <http://example.org/node/retrieval_augmented_generation_rag_capabilities_to_provide_quick_access_to_reliable_information_assistance_in_drafting_professional_documents_support_in_handling_client_files_and_facilitation_of_collaboration_and_mission_continuity_between_collaborators> ;
        rdf:subject <http://example.org/node/atelier> .

    pro:pro4 a ex:Proposal ;
        ns1:ensures <http://example.org/node/response_times_compatible_with_daily_professional_use_with_a_median_latency_of_1_3_seconds_and_a_p95_latency_below_2_5_seconds_for_common_queries> ;
        rdf:subject <http://example.org/node/atelier> .

    pro:pro5 a ex:Proposal ;
        ns1:is_designed_with <http://example.org/node/active_active_redundancy_across_two_availability_zones_to_provide_resilience_to_seasonal_peak_loads> ;
        rdf:subject <http://example.org/node/atelier> .

    pro:pro6 a ex:Proposal ;
        ns1:offers <http://example.org/node/api_type_interfaces_for_integration_with_cabinet_vauclair_associ_s_production_tools_and_electronic_invoicing_dematerialization_environment> ;
        rdf:subject <http://example.org/node/atelier> .

    pro:pro7 a ex:Proposal ;
        ns1:proposes <http://example.org/node/hosting_on_ouranecloud_s_secnumcloud_qualified_infrastructure_which_is_eu_only_and_renewable_powered> ;
        rdf:subject <http://example.org/node/faber_ia> .

    pro:pro8 a ex:Proposal ;
        ns1:ensures <http://example.org/node/all_data_is_hosted_within_eu_with_no_transfer_outside_eu> ;
        rdf:subject <http://example.org/node/ouranecloud_s_infrastructure> .

    pro:pro9 a ex:Proposal ;
        ns1:include <http://example.org/node/strict_partitioning_of_client_files_logical_isolation_per_client_and_mission_access_controls_encryption_in_transit_using_tls_1_3_encryption_at_rest_using_aes_256_and_key_management_on_eu_based_infrastructure> ;
        rdf:subject <http://example.org/node/ouranecloud_s_security_measures> .
}

