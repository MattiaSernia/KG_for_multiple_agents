<http://example.org/extraction/tri/extraction5> {
    tri:tri40 a ex:Triplet ;
        ns1:has_gdpr_compliance_certification <http://example.org/node/iso_27001> ;
        rdf:subject <http://example.org/node/faber_ia> .

