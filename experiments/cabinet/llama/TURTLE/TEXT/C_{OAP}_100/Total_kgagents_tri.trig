        ns1:has_gdpr_compliance_certification_year <http://example.org/node/2023> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri42 a ex:Triplet ;
        ns1:has_privacy_information_management_certification <http://example.org/node/iso_27701> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri43 a ex:Triplet ;
        ns1:uses_encryption_protocol <http://example.org/node/tls_1_3> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri44 a ex:Triplet ;
        ns1:uses_encryption_protocol_at_rest <http://example.org/node/aes_256> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri45 a ex:Triplet ;
        ns1:has_key_management_system_location <http://example.org/node/eu_based_infrastructure> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri46 a ex:Triplet ;
        ns1:has_pseudonymisation_for_sensitive_data <http://example.org/node/yes> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri47 a ex:Triplet ;
        ns1:has_data_minimization_practice <http://example.org/node/yes> ;
