@prefix con: <http://example.org/constraint/> .
@prefix ex: <http://example.org/ontologia#> .
@prefix ns1: <http://example.org/edge/> .
@prefix pro: <http://example.org/proposal/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix req: <http://example.org/requirement/> .
@prefix tri: <http://example.org/triplet/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extraction/con/extraction55> {
    con:con32 a ex:Constraint ;
        ns1:must_enable <http://example.org/node/an_efficient_resumption_by_another_collaborator> ;
        rdf:subject <http://example.org/node/solution> .

    con:con33 a ex:Constraint ;
        ns1:must_enable <http://example.org/node/relevant_information_sharing_between_collaborators> ;
        rdf:subject <http://example.org/node/solution> .

    con:con34 a ex:Constraint ;
        ns1:must_enable <http://example.org/node/the_continuity_of_missions_between_collaborators_by_enabling_relevant_information_sharing_an_understanding_of_the_context_of_an_in_progress_client_file_and_an_efficient_resumption_by_another_collaborator> ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/tri/extraction160> {
    tri:tri217 a ex:Triplet ;
        ns1:combines <http://example.org/node/lexical_search_and_semantic_search> ;
        rdf:subject <http://example.org/node/faberia> .

    tri:tri218 a ex:Triplet ;
        ns1:assists_with <http://example.org/node/retrieval_of_regulatory_and_methodological_information> ;
        rdf:subject <http://example.org/node/ai_assistant> .

    tri:tri219 a ex:Triplet ;
        ns1:limits <http://example.org/node/unsupported_generation> ;
        rdf:subject <http://example.org/node/ai_assistant> .

    tri:tri220 a ex:Triplet ;
        ns1:ensures <http://example.org/node/reliability_of_figures> ;
        rdf:subject <http://example.org/node/ai_assistant> .
}

<http://example.org/extraction/pro/extraction176> {
    pro:pro10 a ex:Proposal ;
        ns1:has <http://example.org/node/regional_accounting_and_statutory_audit_firm> ;
        rdf:subject <http://example.org/node/cabinet_vauclaire_associ_s> .

    pro:pro11 a ex:Proposal ;
        ns1:uses <http://example.org/node/hybrid_delivery_model> ;
        rdf:subject <http://example.org/node/cabinet_vauclaire_associ_s> .

    pro:pro12 a ex:Proposal ;
        ns1:combines <http://example.org/node/agile_iterations_with_a_phase_gate_structure> ;
        rdf:subject <http://example.org/node/cabinet_vauclaire_associ_s> .
}

<http://example.org/extraction/tri/extraction102> {
    tri:tri51 a ex:Triplet ;
        ns1:is <http://example.org/node/fully_covered> ;
        rdf:subject <http://example.org/node/the_requirement_for_common_queries> .
}

<http://example.org/extraction/con/extraction62> {
    con:con47 a ex:Constraint ;
        ns1:must_achieve <http://example.org/node/complete_audit_trail_and_explainability> ;
        ex:constraintType ex:technical ;
        rdf:subject <http://example.org/node/system> .

    con:con48 a ex:Constraint ;
        ns1:shall_not_exceed <http://example.org/node/cabinet_vauclair_associ_s_internal_quality_control_and_statutory_audit_review> ;
        rdf:subject <http://example.org/node/audit> .

    con:con49 a ex:Constraint ;
        ns1:must_comply_with <http://example.org/node/4_4_professional_responsibility_and_independence> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/audit> .
}

<http://example.org/extraction/req/extraction21> {
    req:req44 a ex:Requirement ;
        ns1:must_ensure <http://example.org/node/all_figures_and_factual_statements_are_traceable_to_source_documents> ;
        ex:category ex:information_extraction ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/the_solution> .
}

<http://example.org/extraction/tri/extraction122> {
    tri:tri111 a ex:Triplet ;
        ns1:provides <http://example.org/node/pseudonymisation_and_data_minimisation> ;
        rdf:subject <http://example.org/node/nexus_engineering> .

    tri:tri112 a ex:Triplet ;
        ns1:offers <http://example.org/node/configurable_retention_aligned_to_legal_archival_obligations> ;
        rdf:subject <http://example.org/node/nexus_engineering> .
}

<http://example.org/extraction/req/extraction5> {
    req:req13 a ex:Requirement ;
        ns1:must_be_provided_with <http://example.org/node/an_intelligent_assistance_tool_accessible_from_their_work_environment_supporting_them_in_their_daily_activities> ;
        ex:category ex:agent_assistance ;
        ex:priority ex:must ;
        rdf:subject <http://example.org/node/the_firm_s_professionals> .

    req:req14 a ex:Requirement ;
        ns1:may_cover <http://example.org/node/retrieval_of_regulatory_and_methodological_information_assistance_in_drafting_professional_documents_support_in_handling_client_files_support_for_the_continuity_of_missions_between_collaborators> ;
        ex:priority ex:may ;
        rdf:subject <http://example.org/node/the_intelligent_assistance_tool> .
}

<http://example.org/extraction/con/extraction56> {
    con:con35 a ex:Constraint ;
        ns1:must_comply_with <http://example.org/node/professional_secrecy_and_confidentiality> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/con/extraction65> {
    con:con54 a ex:Constraint ;
        ns1:must_not_undermine <http://example.org/node/cabinet_vauclair_associ_s_anti_money_laundering_obligations_lcb_ft> ;
        ex:constraintType ex:regulatory ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/con/extraction68> {
    con:con58 a ex:Constraint ;
        ns1:must_sustain <http://example.org/node/the_solution_performance_during_seasonal_peak_loads_closing_periods_tax_campaigns> ;
        rdf:subject <http://example.org/node/solution> .

    con:con59 a ex:Constraint ;
        ns1:must_be_compatible_with <http://example.org/node/daily_professional_use> ;
        rdf:subject <http://example.org/node/response_time> .

    con:con60 a ex:Constraint ;
        ns1:must_have_a_response_time_less_than <http://example.org/node/2_0_seconds> ;
        rdf:subject <http://example.org/node/common_queries> .
}

<http://example.org/extraction/tri/extraction136> {
    tri:tri159 a ex:Triplet ;
        ns1:requires <http://example.org/node/additional_guidance_or_expertise> ;
        rdf:subject <http://example.org/node/compliance> .

    tri:tri160 a ex:Triplet ;
        ns1:are_related_to <http://example.org/node/tax_doctrine> ;
        rdf:subject <http://example.org/node/accounting_standards> .

    tri:tri161 a ex:Triplet ;
        ns1:include <http://example.org/node/pcg_tax_code_cgi_commercial_code_and_collective_bargaining_agreements_for_payroll_social> ;
        rdf:subject <http://example.org/node/applicable_legal_texts> .
}

<http://example.org/extraction/con/extraction75> {
    con:con71 a ex:Constraint ;
        ns1:is <http://example.org/node/sme> ;
        rdf:subject <http://example.org/node/candidate> .

    con:con72 a ex:Constraint ;
        ns1:must_achieve <http://example.org/node/optimisation_of_costs> ;
        ex:constraintType ex:budgetary ;
        rdf:subject <http://example.org/node/solution> .

    con:con73 a ex:Constraint ;
        ns1:must_guarantee <http://example.org/node/expected_quality_of_service> ;
        ex:constraintType ex:quality ;
        rdf:subject <http://example.org/node/solution> .
}

<http://example.org/extraction/tri/extraction149> {
    tri:tri187 a ex:Triplet ;
        ns1:has <http://example.org/node/220_000_reference_budget_over_3_years> ;
        rdf:subject <http://example.org/node/the_project> .

    tri:tri188 a ex:Triplet ;
        ns1:has <http://example.org/node/global_budget_of_220_000> ;
        rdf:subject <http://example.org/node/the_client> .
}

