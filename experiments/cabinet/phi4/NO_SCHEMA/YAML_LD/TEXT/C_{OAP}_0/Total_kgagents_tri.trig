    <http://example.org/node/chunk159> a prov:Entity ;
        ex:hasText "Faber IA have high availability during business hours and resilience to peak loads, thanks to Faber IA active-active setup across two availability zones and the ability to scale horizontally." ;
        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk16> a prov:Entity ;
        ex:hasText "Regulatory, professional and legal constraints  4.1 Professional secrecy and confidentiality." ;
        prov:wasDerivedFrom <http://example.org/node/message0> .

    <http://example.org/node/chunk160> a prov:Entity ;
        ex:hasText "Faber IA will integrate Our Atelier platform with the client existing systems, including accounting-production software, payroll software, document management (GED), and electronic-invoicing/dematerialisation environments." ;
