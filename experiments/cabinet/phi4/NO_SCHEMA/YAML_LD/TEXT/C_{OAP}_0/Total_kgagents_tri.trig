        prov:wasDerivedFrom <http://example.org/node/message16> .

    <http://example.org/node/chunk158> a prov:Entity ;
        ex:hasText "Our Atelier platform, is a Retrieval-augmented generation (RAG) platform that can handle common queries with a median latency of 1.3 seconds and a p95 latency below 2.5 seconds." ;
