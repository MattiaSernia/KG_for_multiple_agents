    <http://example.org/node/chunk107> a prov:Entity ;
        ex:hasText "Specifically, our company's are ISO 27001 certified since 2023, which covers the scope of Development, delivery, and operations. our company's also have ISO 27701 certification for privacy information management extension.  our company's data protection measures include encryption in transit using TLS 1.3 and encryption at rest using AES-256, with key management based on the EU-based infrastructure. our company's implement strict partitioning with logical isolation per client and per mission, preventing any cross-client circulation of data." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "Pseudonymisation is also supported where relevant." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk109> a prov:Entity ;
        ex:hasText "Regarding GDPR compliance, our company's have experience delivering solutions to clients bound by professional secrecy, including a national professional order. our company's system ensures that client file handling supports the continuity of missions between collaborators while maintaining strict confidentiality. our company's also comply with anti-money laundering obligations (LCB-FT) and do not undermine a firm's reporting obligations." ;
        prov:wasDerivedFrom <http://example.org/node/message7> .

    <http://example.org/node/chunk11> a prov:Entity ;
        ex:hasText "Assistance in drafting client letters and correspondence, mission notes, file memos and syntheses." ;
