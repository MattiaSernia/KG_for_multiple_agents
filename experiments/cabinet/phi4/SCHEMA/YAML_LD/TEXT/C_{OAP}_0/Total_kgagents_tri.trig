@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/extraction/tri/extraction114> {
    tri:tri79 a ex:Triplet ;
        ns1:ensures <http://example.org/node/only_authorized_personnel_can_access_client_data> ;
        rdf:subject <http://example.org/node/faber_ia_role_based_access_control> .
}

<http://example.org/extraction/con/extraction76> {
    con:con77 a ex:Constraint ;
        ns1:wishes_to_limit <http://example.org/node/the_environmental_footprint_of_the_solution> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/cabinet_vauclair_associ_s> .

    con:con78 a ex:Constraint ;
        ns1:wishes_to_rely_on <http://example.org/node/low_carbon_infrastructure> ;
        ex:constraintType ex:environmental ;
        rdf:subject <http://example.org/node/cabinet_vauclair_associ_s> .
}

<http://example.org/extraction/con/extraction72> {
    con:con71 a ex:Constraint ;
        ns1:must_be_hosted_on <http://example.org/node/secnumcloud_qualified_infrastructure_or_equivalent> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/data> .

    con:con72 a ex:Constraint ;
        ns1:must_not_be_located_in <http://example.org/node/non_european_countries> ;
        ex:constraintType ex:sovereignty ;
        rdf:subject <http://example.org/node/supplier> .
}

<http://example.org/extraction/tri/extraction111> {
    tri:tri73 a ex:Triplet ;
        ns1:complies_with <http://example.org/node/gdpr_specifically_art_28> ;
        rdf:subject <http://example.org/node/faber_ia> .

    tri:tri74 a ex:Triplet ;
        ns1:supports <http://example.org/node/personal_data_protection> ;
        rdf:subject <http://example.org/node/faber_ia_data_processing_agreement> .

    tri:tri75 a ex:Triplet ;
        ns1:complies_with <http://example.org/node/gdpr_specifically_art_28> ;
        rdf:subject <http://example.org/node/faber_ia_data_processing_agreement> .
}

