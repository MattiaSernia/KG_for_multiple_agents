    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "As the Security and Compliance officer at our company's, the Security and Compliance officer at Faber IA can confirm that our company's holds ISO 27001 certification since 2023, which covers development, delivery, and operations." ;
