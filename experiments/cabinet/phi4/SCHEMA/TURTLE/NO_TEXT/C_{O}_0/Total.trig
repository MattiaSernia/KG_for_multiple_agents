    <http://example.org/node/chunk120> a prov:Entity ;
        ex:hasText "As for potential legal risks and liabilities, non-compliance with GDPR, EU AI Act emerging requirements, or other regulatory obligations may expose our company's to significant fines and reputational damage." ;
