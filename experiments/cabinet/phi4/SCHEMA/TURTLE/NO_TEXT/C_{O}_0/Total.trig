    <http://example.org/node/chunk143> a prov:Entity ;
        ex:hasText "The client demands a solution that limits environmental footprint, relies on low-carbon infrastructure, and demonstrates corporate social responsibility." ;
        prov:wasDerivedFrom <http://example.org/node/message15> .

    <http://example.org/node/chunk144> a prov:Entity ;
