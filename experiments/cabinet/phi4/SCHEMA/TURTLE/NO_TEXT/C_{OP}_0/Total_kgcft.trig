        ex:hasText "The client requires a solution that respects professional secrecy and confidentiality of client data, complies with regulatory, professional, and legal constraints, and does not undermine Cabinet Vauclair Associés' anti-money laundering obligations." ;
        prov:wasDerivedFrom <http://example.org/node/message9> .

    <http://example.org/node/chunk121> a prov:Entity ;
