    <http://example.org/node/chunk91> a prov:Entity ;
        ex:hasText "In terms of governance, our company's will establish a joint steering committee and operational committee, with a single accountable project director as the point of contact. our company's RACI matrix will formalize roles, and our company's will have a documented escalation path in place." ;
        prov:wasDerivedFrom <http://example.org/node/message3> .

    <http://example.org/node/chunk92> a prov:Entity ;
