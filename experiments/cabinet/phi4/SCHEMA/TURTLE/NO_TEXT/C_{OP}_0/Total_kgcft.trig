    <http://example.org/node/chunk93> a prov:Entity ;
        ex:hasText "The client requires a technical architecture that ensures response times below 2 seconds, integrates with Cabinet Vauclair Associés' production tools (accounting production software, payroll software, document management GED), electronic invoicing dematerialisation environment, and user directory SSO." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk94> a prov:Entity ;
