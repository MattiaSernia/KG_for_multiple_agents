    <http://example.org/node/chunk102> a prov:Entity ;
        ex:hasText "With a median latency of 1.3 seconds and a p95 latency below 2.5 seconds for common queries, Our company, Faber IA can achieve response times compatible with daily professional use." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk103> a prov:Entity ;
        ex:hasText "For high availability during business hours, a Retrieval-augmented generation (RAG) platform called Atelier can be deployed on OuraneCloud sovereign tier, which provides active-active redundancy across two availability zones. deployed will ensure that a Retrieval-augmented generation (RAG) platform called Atelier is highly available and resilient to peak loads." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk104> a prov:Entity ;
        ex:hasText "To reduce the impact of seasonal peak loads, Our company, Faber IA can scale a Retrieval-augmented generation (RAG) platform called Atelier horizontally, sizing capacity for seasonal peak loads such as closing periods and tax campaigns." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk105> a prov:Entity ;
        ex:hasText "Our company, Faber IA containerisation using Kubernetes will enable efficient scaling and management of resources." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk106> a prov:Entity ;
        ex:hasText "Finally, to respect confidentiality and security, Our company, Faber IA can implement strict access controls, ensuring that client files are strictly partitioned and audited per client file." ;
