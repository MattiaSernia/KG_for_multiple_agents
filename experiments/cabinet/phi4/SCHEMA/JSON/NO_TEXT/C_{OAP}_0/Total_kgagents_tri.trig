    <http://example.org/node/chunk101> a prov:Entity ;
        ex:hasText "To meet performance requirements, a Retrieval-augmented generation (RAG) platform called Atelier orchestration layer can route queries through retrieval, generation, and post-processing, ensuring efficient processing of requests." ;
