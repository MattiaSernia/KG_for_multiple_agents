        prov:wasDerivedFrom <http://example.org/node/message5> .

    <http://example.org/node/chunk108> a prov:Entity ;
        ex:hasText "By leveraging Our company, Faber IA a Retrieval-augmented generation (RAG) platform called Atelier platform, sovereign hosting options, and technical capabilities, Our company, Faber IA can design a technical architecture that meets the client's requirements and demands, providing a reliable, efficient, and secure solution for the client's staff." ;
        prov:wasDerivedFrom <http://example.org/node/message5> .

